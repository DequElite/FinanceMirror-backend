type Spending {
    id: ID
    date: String
    price: Int
    category: String
    description: String
}

type Replenishment {
    id: ID
    date: String
    amount: Int
    type: String
    description: String
}

type Report {
    id: ID
    type: String
    totalSpent: Int
    expensiveCategory: String
    spentPercentOfSalary: Int
    averageDailySpending: Int
    dailyLimit: Int
    reportBalance: Int
    financeResult: String
    expenditureRate: String
    leakProblem: String
    advice: String
    created_at: String
}


type Subscription {
    id: String
    type: String
    status: String
    started_at: String
    created_at: String
    updated_at: String
    expires_at: String
}

type HistoryReport {
    id: String
    createdAt: String
    updatedAt: String

    periodStartDate: String
    periodEndDate: String

    totalSpent: Int
    currentBalance: Int
    totalReplenishments: Int
    averageDailySpending: Int

    spentDifference: Int
    spentDifferencePercent: Int

    replenishedDifference: Int
    replenishedDifferencePercent: Int

    balanceDifference: Int
    balanceDifferencePercent: Int

    averageDailySpendingDifference: Int
    averageDailySpendingDifferencePercent: Int
}

type Profile {
    id: ID
    email: String
    balance: Int
    monthSalary: Int
    currency: String
    spendings: [Spending]
    replenishment: [Replenishment]
    subscription: Subscription
}


type Dashboard {
    latest_report: Report
    left_until_payday: Int
    reports: [Report]
    history_reports: [HistoryReport]
}

type Query {
    profile: Profile
    dashboard: Dashboard
}