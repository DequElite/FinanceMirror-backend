type Spending {
    id: ID
    date: String
    price: Int
    category: String
    description: String
}

type Report {
    id: ID
    weeklySpending: Int
    expensiveCategory: String
    spent_percent_of_salary: Int
    average_daily_spending: Int
    daily_limit: Int
    report_balance: Int
    expenditureRate: String
    leakProblem: String
    advice: String
}

type Profile {
    id: ID
    email: String
    balance: Int
    monthSalary: Int
    currency: String
    spendings: [Spending]
    reports: [Report]
}

type Dashboard {
    latest_report: Report
    left_until_payday: Int
}

type Query {
    profile: Profile
    dashboard: Dashboard
}