type Spending {
    id: ID
    date: String
    price: Int
    category: String
    description: String
}

type Report {
    id: ID
    weekly_spending: Int
    expensive_category: String
    remains: String
    expenditure_rate: String
    leak_problem: String
    advice: String
}

type Profile {
    id: ID
    email: String
    month_salary: Int
    spendings: [Spending]
    reports: [Report]
}

type Dashboard {
    latest_report: Report
    left_until_payday: Int
}

type Query {
    profile: Profile
    dashboard: Dashboard
}